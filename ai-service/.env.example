# Copy to .env for local dev (never commit the real .env).
# On Render, set these in the service's Environment tab instead.

OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4o-mini

# Comma-separated allowed origins for CORS, or * while developing.
ALLOWED_ORIGINS=*

# Local port (Render injects its own PORT).
PORT=8081
